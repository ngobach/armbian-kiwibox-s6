index 0000000..61fda3c
--- /dev/null
+++ b/arch/arm/boot/dts/amlogic/meson8b-kiwibox-s6.dts
@@ -0,0 +1,384 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Kiwibox S6 - Amlogic S805 (Meson8b) TV box
+ *
+ * Reconstructed from the vendor Android 4.4.2 firmware (m201-ota-20150701,
+ * build path ".../release_m8_kitkat44_0823patch_20150313-s805/1g/ap6181/...",
+ * DTBs m8b_m201_1G / m8b_m201C_512M) plus the upstream meson8b-mxq and
+ * meson8b-odroidc1 reference trees.
+ *
+ * Build against a v6.12.y tree carrying Armbian's
+ * patch/kernel/archive/meson-6.12 series (VPU/HDMI/CEC/hhi patches).
+ *
+ * Confidence per subsystem:
+ *   HIGH    CPU, RAM (1 GiB), SD card, IR receiver, HDMI-only display,
+ *           power button (GPIOAO_3), USB host ports
+ *   MEDIUM  eMMC (8-bit via SDHC controller; reset line on BOOT_9 assumed)
+ *   LOW     ethernet PHY wiring, VCCK PWM regulator mapping, WiFi
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+#include "meson8b.dtsi"
+
+/ {
+	model = "Kiwibox S6";
+	compatible = "kiwibox,s6", "amlogic,meson8b";
+
+	aliases {
+		serial0 = &uart_AO;
+		mmc0 = &sd_card_slot;
+		mmc1 = &sdhc;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * 1 GiB. The vendor DTB uses phys_offset 0x200000 and
+	 * linux,total-memory = <0x3fe00000>; upstream maps DRAM at
+	 * 0x40000000 and reserves the low 2 MiB via meson8b.dtsi.
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x40000000>;
+	};
+
+	/*
+	 * Vendor "sdhc" node drives eMMC on port 5, 8-bit, no reset GPIO
+	 * described. BOOT_9 is the SoC's dedicated eMMC RSTn pad, so model
+	 * it as a pwrseq like the Odroid-C1 does. If eMMC fails to probe,
+	 * drop this pwrseq and the mmc-pwrseq reference below.
+	 */
+	emmc_pwrseq: emmc-pwrseq {
+		compatible = "mmc-pwrseq-emmc";
+		reset-gpios = <&gpio BOOT_9 GPIO_ACTIVE_LOW>;
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&hdmi_tx_tmds_out>;
+			};
+		};
+	};
+
+	/* HDMI audio, wired up exactly like Armbian's meson8b-mxq patch */
+	sound {
+		compatible = "amlogic,gx-sound-card";
+		model = "Kiwibox S6";
+
+		assigned-clocks = <&clkc CLKID_MPLL0>,
+				  <&clkc CLKID_MPLL1>;
+		assigned-clock-rates = <294912000>,
+				       <270950400>;
+
+		dai-link-0 {
+			sound-dai = <&aiu AIU_CPU CPU_I2S_FIFO>;
+		};
+
+		dai-link-1 {
+			sound-dai = <&aiu AIU_CPU CPU_I2S_ENCODER>;
+			dai-format = "i2s";
+			mclk-fs = <256>;
+
+			codec-0 {
+				sound-dai = <&aiu AIU_HDMI CTRL_I2S>;
+			};
+		};
+
+		dai-link-2 {
+			sound-dai = <&aiu AIU_HDMI CTRL_OUT>;
+
+			codec-0 {
+				sound-dai = <&hdmi_tx 0>;
+			};
+		};
+	};
+
+	/*
+	 * Front panel power button: vendor gpio_keypad on GPIOAO_3,
+	 * key_code 0x74 (KEY_POWER). Polled on purpose - the AO GPIO bank
+	 * is not an interrupt controller and the gpio_intc channel for
+	 * GPIOAO_3 has not been verified on this board yet. Once confirmed,
+	 * this can become "gpio-keys" with interrupt-parent = <&gpio_intc>
+	 * and interrupts = <3 IRQ_TYPE_LEVEL_LOW>.
+	 */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+		autorepeat;
+
+		power {
+			label = "power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	vcc_5v: regulator-vcc-5v {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC5V";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vcc_3v3: regulator-vcc-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc_5v>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vcc_1v8: regulator-vcc-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC1V8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vcc_3v3>;
+	};
+
+	/*
+	 * VCCK is generated by a PWM controlled regulator on PWM_C
+	 * (GPIODV_9), see the vendor "meson_vcck_dvfs_driver" node
+	 * (use_pwm, PWM_C). Its cs_voltage_table says:
+	 *     duty 0x1c (28/32) -> 860 mV ... duty 0 -> 1140 mV
+	 * i.e. inverted: more duty = lower voltage. The mapping below is
+	 * the same shape as meson8b-mxq's VCCK but has NOT been measured
+	 * on this board. If the box is unstable or runs hot, scope VCCK
+	 * against CPU frequency and adjust pwm-dutycycle-range
+	 * (e.g. <88 0> would match the vendor's 28/32 endpoint).
+	 */
+	vcck: regulator-vcck {
+		compatible = "pwm-regulator";
+		regulator-name = "VCCK";
+		regulator-min-microvolt = <860000>;
+		regulator-max-microvolt = <1140000>;
+		pwm-supply = <&vcc_5v>;
+		pwms = <&pwm_cd 0 1148 0>;
+		pwm-dutycycle-range = <100 0>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&vcck>;
+};
+
+&efuse {
+	ethernet_mac_address: mac@1b4 {
+		reg = <0x1b4 0x6>;
+	};
+};
+
+/*
+ * 100 Mbit RMII PHY on the internal meson8b MAC.
+ *
+ * The vendor DTB only describes "amlogic,meson-eth" and never names the
+ * PHY, so the wiring below is the M201-class meson8b-mxq layout. If there
+ * is no link, in this order:
+ *   1. read the PHY chip markings and try another mdio address (reg = <1..7>)
+ *   2. drop reset-gpios / interrupt if GPIOH_4 / GPIOH_3 are not wired
+ *   3. if it is an IC+ part, make sure CONFIG_ICPLUS_PHY=y is set
+ *      (Armbian's linux-meson-current.config does not enable it)
+ *
+ * The icplus,select-interrupt property below is only meaningful for
+ * IC+ PHYs; drop it if the chip turns out to be something else.
+ */
+&ethmac {
+	status = "okay";
+
+	pinctrl-0 = <&eth_rmii_pins>;
+	pinctrl-names = "default";
+
+	phy-handle = <&eth_phy>;
+	phy-mode = "rmii";
+
+	nvmem-cells = <&ethernet_mac_address>;
+	nvmem-cell-names = "mac-address";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		eth_phy: ethernet-phy@0 {
+			reg = <0>;
+
+			reset-assert-us = <10000>;
+			reset-deassert-us = <10000>;
+			reset-gpios = <&gpio GPIOH_4 GPIO_ACTIVE_LOW>;
+
+			icplus,select-interrupt;
+			interrupt-parent = <&gpio_intc>;
+			interrupts = <17 IRQ_TYPE_LEVEL_LOW>; /* GPIOH_3 */
+		};
+	};
+};
+
+&ir_receiver {
+	status = "okay";
+	pinctrl-0 = <&ir_recv_pins>;
+	pinctrl-names = "default";
+};
+
+/*
+ * The vendor DVFS table only drives VCCK. Whatever rails the GPU, it is
+ * fixed on this board, so mali-supply is intentionally left unset.
+ */
+
+&pwm_cd {
+	status = "okay";
+	pinctrl-0 = <&pwm_c1_pins>, <&pwm_d_pins>;
+	pinctrl-names = "default";
+	clocks = <&xtal>, <&xtal>;
+	clock-names = "clkin0", "clkin1";
+};
+
+&saradc {
+	status = "okay";
+	vref-supply = <&vcc_1v8>;
+};
+
+/* eMMC: vendor sdhc port 5, 8-bit. No vqmmc: the IO rail is unverified. */
+&sdhc {
+	status = "okay";
+
+	pinctrl-0 = <&sdxc_c_pins>;
+	pinctrl-names = "default";
+
+	bus-width = <8>;
+	max-frequency = <100000000>;
+	non-removable;
+	no-sdio;
+	cap-mmc-highspeed;
+
+	mmc-pwrseq = <&emmc_pwrseq>;
+	vmmc-supply = <&vcc_3v3>;
+};
+
+&sdio {
+	status = "okay";
+
+	pinctrl-0 = <&sd_b_pins>;
+	pinctrl-names = "default";
+
+	/* SD card: vendor port 1, card detect on CARD_6 */
+	sd_card_slot: slot@1 {
+		compatible = "mmc-slot";
+		reg = <1>;
+		status = "okay";
+
+		bus-width = <4>;
+		no-sdio;
+		cap-mmc-highspeed;
+		cap-sd-highspeed;
+		disable-wp;
+
+		cd-gpios = <&gpio CARD_6 GPIO_ACTIVE_LOW>;
+
+		vmmc-supply = <&vcc_3v3>;
+	};
+
+	/*
+	 * WiFi is an Ampak AP6181 (Broadcom BCM43362) on SDIO port 0:
+	 *   vendor DTS: irq GPIOX_21, power GPIOAO_6 + GPIOX_11,
+	 *               32k clock GPIOX_10, BT reset GPIOX_20
+	 *   firmware path: ".../1g/ap6181/uboot/..."
+	 *
+	 * Not enabled here for two reasons:
+	 *   1. pinctrl-meson8b.c does define the port 0 pin groups (sd_a:
+	 *      GPIOX_0..3 = sd_d0_a..sd_d3_a, GPIOX_8 = sd_clk_a,
+	 *      GPIOX_9 = sd_cmd_a), but meson8b.dtsi exposes no label for
+	 *      them (only sd_b_pins / sdxc_c_pins), so a small dtsi patch
+	 *      is needed before the DTS can reference them.
+	 *   2. meson-mx-sdio.c only registers the FIRST "mmc-slot" child
+	 *      ("we only register the first slot for now"), so adding slot@0
+	 *      would silently take over from the SD card in slot@1 unless the
+	 *      driver grows multi-slot support.
+	 *
+	 * The controller itself is fine: brcmfmac supports BCM43362
+	 * (BRCMF_FW_ENTRY in sdio.c) and brcmfmac43362-sdio.bin ships in
+	 * linux-firmware. The board NVRAM must come from the vendor image:
+	 * system/etc/wifi/40181/nvram.txt -> brcmfmac43362-sdio.txt.
+	 *
+	 * Sketch once the two driver items exist:
+	 *
+	 *   wifi_pwrseq: wifi-pwrseq {
+	 *           compatible = "mmc-pwrseq-simple";
+	 *           reset-gpios = <&gpio GPIOX_11 GPIO_ACTIVE_LOW>;
+	 *   };
+	 *
+	 *   wifi_reg: regulator-wifi {
+	 *           compatible = "regulator-fixed";
+	 *           regulator-name = "WIFI_3V3";
+	 *           regulator-min-microvolt = <3300000>;
+	 *           regulator-max-microvolt = <3300000>;
+	 *           gpio = <&gpio_ao GPIOAO_6 GPIO_ACTIVE_HIGH>;
+	 *           enable-active-high;
+	 *   };
+	 *
+	 *   &sdio { slot@0 { compatible = "mmc-slot"; reg = <0>;
+	 *                    bus-width = <4>; non-removable; no-sd;
+	 *                    keep-power-in-suspend; cap-power-off-card;
+	 *                    mmc-pwrseq = <&wifi_pwrseq>;
+	 *                    vmmc-supply = <&wifi_reg>; }; };
+	 *
+	 * plus brcmfmac OOB IRQ on GPIOX_21.
+	 */
+};
+
+&uart_AO {
+	status = "okay";
+	pinctrl-0 = <&uart_ao_a_pins>;
+	pinctrl-names = "default";
+};
+
+/* Vendor usb_con: usb_a (port 0) + usb_b (port 1), both host */
+&usb0 {
+	status = "okay";
+	dr_mode = "host";
+};
+
+&usb0_phy {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+	dr_mode = "host";
+};
+
+&usb1_phy {
+	status = "okay";
+};
+
+/* Display: HDMI only (vendor build.prop has cvbsmode=false) */
+&aiu {
+	status = "okay";
+};
+
+&hdmi_tx {
+	status = "okay";
+	pinctrl-0 = <&hdmi_hpd_pins>, <&hdmi_i2c_pins>;
+	pinctrl-names = "default";
+};
+
+&hdmi_tx_tmds_port {
+	hdmi_tx_tmds_out: endpoint {
+		remote-endpoint = <&hdmi_connector_in>;
+	};
+};
