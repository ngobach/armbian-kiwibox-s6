From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kiwibox S6 port <bachnx@users.noreply.github.com>
Subject: [PATCH] mmc: meson-mx-sdio: support more than one slot (experimental)

The Meson8/8b SDIO controller multiplexes up to three ports onto one
command engine. The upstream driver only registers the first "mmc-slot"
child because the MMC core gives mmc_claim_host() exclusive access to a
host, not to a shared controller, so protocol sequences of one slot can
be interleaved with requests of another slot (see the 2017 linux-mmc
discussion). A correct implementation needs MMC core changes.

This patch is an out-of-tree stop-gap for boards that need a second
slot (e.g. an SD card plus an SDIO WiFi module) at the same time:
- one mmc_host is registered per enabled "mmc-slot" child
- the shared command engine and CONF register are claimed per request
- the per-slot bus width and clock rate are re-applied at the start of
  every request (they live in the shared CONF register)

It is expected to work for independent SD and SDIO cards, but it is not
upstream quality and needs hardware validation.
---

diff --git a/drivers/mmc/host/meson-mx-sdio.c b/drivers/mmc/host/meson-mx-sdio.c
index a11577f..52cfb09 100644
--- a/drivers/mmc/host/meson-mx-sdio.c
+++ b/drivers/mmc/host/meson-mx-sdio.c
@@ -17,10 +17,12 @@
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/ioport.h>
+#include <linux/list.h>
 #include <linux/platform_device.h>
 #include <linux/of_platform.h>
 #include <linux/timer.h>
 #include <linux/types.h>
+#include <linux/wait.h>
 
 #include <linux/mmc/host.h>
 #include <linux/mmc/mmc.h>
@@ -98,8 +100,10 @@
 #define MESON_MX_SDIO_RESPONSE_CRC16_BITS			(16 - 1)
 #define MESON_MX_SDIO_MAX_SLOTS					3
 
-struct meson_mx_mmc_host {
-	struct device			*controller_dev;
+struct meson_mx_mmc_host;
+
+struct meson_mx_mmc_shared {
+	struct device			*dev;
 
 	struct clk			*parent_clk;
 	struct clk			*core_clk;
@@ -110,16 +114,32 @@ struct meson_mx_mmc_host {
 
 	void __iomem			*base;
 	int				irq;
-	spinlock_t			irq_lock;
+	spinlock_t			lock;
+
+	/*
+	 * The command engine and the CONF register (bus width, clock
+	 * divider) are shared between all slots, so only one slot may have
+	 * a request in flight at any time.
+	 */
+	struct meson_mx_mmc_host	*active;
+	struct meson_mx_mmc_host	*irq_host;
+	wait_queue_head_t		idle_wq;
+	struct list_head		slots;
+};
+
+struct meson_mx_mmc_host {
+	struct meson_mx_mmc_shared	*shared;
+	struct mmc_host			*mmc;
 
 	struct timer_list		cmd_timeout;
 
 	unsigned int			slot_id;
-	struct mmc_host			*mmc;
 
 	struct mmc_request		*mrq;
 	struct mmc_command		*cmd;
 	int				error;
+
+	struct list_head		node;
 };
 
 static void meson_mx_mmc_mask_bits(struct mmc_host *mmc, char reg, u32 mask,
@@ -128,16 +148,17 @@ static void meson_mx_mmc_mask_bits(struct mmc_host *mmc, char reg, u32 mask,
 	struct meson_mx_mmc_host *host = mmc_priv(mmc);
 	u32 regval;
 
-	regval = readl(host->base + reg);
+	regval = readl(host->shared->base + reg);
 	regval &= ~mask;
 	regval |= (val & mask);
 
-	writel(regval, host->base + reg);
+	writel(regval, host->shared->base + reg);
 }
 
-static void meson_mx_mmc_soft_reset(struct meson_mx_mmc_host *host)
+static void meson_mx_mmc_soft_reset(struct meson_mx_mmc_shared *shared)
 {
-	writel(MESON_MX_SDIO_IRQC_SOFT_RESET, host->base + MESON_MX_SDIO_IRQC);
+	writel(MESON_MX_SDIO_IRQC_SOFT_RESET,
+	       shared->base + MESON_MX_SDIO_IRQC);
 	udelay(2);
 }
 
@@ -213,13 +234,13 @@ static void meson_mx_mmc_start_cmd(struct mmc_host *mmc,
 	send |= FIELD_PREP(MESON_MX_SDIO_SEND_COMMAND_INDEX_MASK,
 			   (0x40 | cmd->opcode));
 
-	spin_lock_irqsave(&host->irq_lock, irqflags);
+	spin_lock_irqsave(&host->shared->lock, irqflags);
 
-	mult = readl(host->base + MESON_MX_SDIO_MULT);
+	mult = readl(host->shared->base + MESON_MX_SDIO_MULT);
 	mult &= ~MESON_MX_SDIO_MULT_PORT_SEL_MASK;
 	mult |= FIELD_PREP(MESON_MX_SDIO_MULT_PORT_SEL_MASK, host->slot_id);
 	mult |= BIT(31);
-	writel(mult, host->base + MESON_MX_SDIO_MULT);
+	writel(mult, host->shared->base + MESON_MX_SDIO_MULT);
 
 	/* enable the CMD done interrupt */
 	meson_mx_mmc_mask_bits(mmc, MESON_MX_SDIO_IRQC,
@@ -231,37 +252,59 @@ static void meson_mx_mmc_start_cmd(struct mmc_host *mmc,
 			       MESON_MX_SDIO_IRQS_CMD_INT,
 			       MESON_MX_SDIO_IRQS_CMD_INT);
 
-	writel(cmd->arg, host->base + MESON_MX_SDIO_ARGU);
-	writel(ext, host->base + MESON_MX_SDIO_EXT);
-	writel(send, host->base + MESON_MX_SDIO_SEND);
+	writel(cmd->arg, host->shared->base + MESON_MX_SDIO_ARGU);
+	writel(ext, host->shared->base + MESON_MX_SDIO_EXT);
+	writel(send, host->shared->base + MESON_MX_SDIO_SEND);
 
-	spin_unlock_irqrestore(&host->irq_lock, irqflags);
+	spin_unlock_irqrestore(&host->shared->lock, irqflags);
 
 	mod_timer(&host->cmd_timeout, jiffies + timeout);
 }
 
 static void meson_mx_mmc_request_done(struct meson_mx_mmc_host *host)
 {
+	struct meson_mx_mmc_shared *shared = host->shared;
 	struct mmc_request *mrq;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&shared->lock, irqflags);
 
 	mrq = host->mrq;
+	if (!mrq) {
+		/* already completed from the IRQ or timeout path */
+		spin_unlock_irqrestore(&shared->lock, irqflags);
+		return;
+	}
 
-	if (host->cmd->error)
-		meson_mx_mmc_soft_reset(host);
+	if (host->cmd && host->cmd->error)
+		meson_mx_mmc_soft_reset(shared);
 
 	host->mrq = NULL;
 	host->cmd = NULL;
+	shared->active = NULL;
+
+	spin_unlock_irqrestore(&shared->lock, irqflags);
 
+	wake_up(&shared->idle_wq);
 	mmc_request_done(host->mmc, mrq);
 }
 
-static void meson_mx_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+/*
+ * The clock divider and the bus width live in the shared CONF register.
+ * They are programmed again at the start of every request (and here while
+ * no request is in flight) so that each slot runs with its own ios.
+ */
+static int meson_mx_mmc_apply_ios(struct meson_mx_mmc_host *host)
 {
-	struct meson_mx_mmc_host *host = mmc_priv(mmc);
-	unsigned short vdd = ios->vdd;
