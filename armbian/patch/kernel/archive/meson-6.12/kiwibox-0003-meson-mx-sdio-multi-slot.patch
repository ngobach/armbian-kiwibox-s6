-	struct mmc_command *cmd = mrq->cmd;
+	struct meson_mx_mmc_shared *shared = host->shared;
+	unsigned long irqflags;
+
+	/*
+	 * All slots share the command engine, so wait until it is free and
+	 * claim it for this request.
+	 */
+	for (;;) {
+		spin_lock_irqsave(&shared->lock, irqflags);
+		if (!shared->active) {
+			shared->active = host;
+			spin_unlock_irqrestore(&shared->lock, irqflags);
+			break;
+		}
+		spin_unlock_irqrestore(&shared->lock, irqflags);
+		wait_event(shared->idle_wq, !READ_ONCE(shared->active));
+	}
+
+	if (!host->error)
+		host->error = meson_mx_mmc_apply_ios(host);
 
 	if (!host->error)
 		host->error = meson_mx_mmc_map_dma(mmc, mrq);
 
+	host->mrq = mrq;
+
 	if (host->error) {
-		cmd->error = host->error;
-		mmc_request_done(mmc, mrq);
+		mrq->cmd->error = host->error;
+		meson_mx_mmc_request_done(host);
 		return;
 	}
 
-	host->mrq = mrq;
-
 	if (mrq->data)
 		writel(sg_dma_address(mrq->data->sg),
-		       host->base + MESON_MX_SDIO_ADDR);
+		       shared->base + MESON_MX_SDIO_ADDR);
 
 	if (mrq->sbc)
 		meson_mx_mmc_start_cmd(mmc, mrq->sbc);
@@ -367,21 +466,21 @@ static void meson_mx_mmc_read_response(struct mmc_host *mmc,
 	u32 mult;
 	int i, resp[4];
 
-	mult = readl(host->base + MESON_MX_SDIO_MULT);
+	mult = readl(host->shared->base + MESON_MX_SDIO_MULT);
 	mult |= MESON_MX_SDIO_MULT_WR_RD_OUT_INDEX;
 	mult &= ~MESON_MX_SDIO_MULT_RESP_READ_INDEX_MASK;
 	mult |= FIELD_PREP(MESON_MX_SDIO_MULT_RESP_READ_INDEX_MASK, 0);
-	writel(mult, host->base + MESON_MX_SDIO_MULT);
+	writel(mult, host->shared->base + MESON_MX_SDIO_MULT);
 
 	if (cmd->flags & MMC_RSP_136) {
 		for (i = 0; i <= 3; i++)
-			resp[3 - i] = readl(host->base + MESON_MX_SDIO_ARGU);
+			resp[3 - i] = readl(host->shared->base + MESON_MX_SDIO_ARGU);
 		cmd->resp[0] = (resp[0] << 8) | ((resp[1] >> 24) & 0xff);
 		cmd->resp[1] = (resp[1] << 8) | ((resp[2] >> 24) & 0xff);
 		cmd->resp[2] = (resp[2] << 8) | ((resp[3] >> 24) & 0xff);
 		cmd->resp[3] = (resp[3] << 8);
 	} else if (cmd->flags & MMC_RSP_PRESENT) {
-		cmd->resp[0] = readl(host->base + MESON_MX_SDIO_ARGU);
+		cmd->resp[0] = readl(host->shared->base + MESON_MX_SDIO_ARGU);
