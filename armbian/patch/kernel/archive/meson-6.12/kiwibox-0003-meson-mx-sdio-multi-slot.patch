+	struct mmc_host *mmc = host->mmc;
+	struct meson_mx_mmc_shared *shared = host->shared;
+	unsigned long clk_rate = mmc->ios.clock;
+	int err;
+
+	/* re-apply the shared registers for the slot that is selected next */
+	meson_mx_mmc_soft_reset(shared);
 
-	switch (ios->bus_width) {
+	switch (mmc->ios.bus_width) {
 	case MMC_BUS_WIDTH_1:
 		meson_mx_mmc_mask_bits(mmc, MESON_MX_SDIO_CONF,
 				       MESON_MX_SDIO_CONF_BUS_WIDTH, 0);
@@ -276,20 +319,32 @@ static void meson_mx_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
 	case MMC_BUS_WIDTH_8:
 	default:
 		dev_err(mmc_dev(mmc), "unsupported bus width: %d\n",
-			ios->bus_width);
-		host->error = -EINVAL;
-		return;
+			mmc->ios.bus_width);
+		return -EINVAL;
 	}
 
-	host->error = clk_set_rate(host->cfg_div_clk, ios->clock);
-	if (host->error) {
+	if (!clk_rate)
+		return 0;
+
+	err = clk_set_rate(shared->cfg_div_clk, clk_rate);
+	if (err) {
 		dev_warn(mmc_dev(mmc),
-				"failed to set MMC clock to %lu: %d\n",
-				clk_rate, host->error);
-		return;
+			 "failed to set MMC clock to %lu: %d\n",
+			 clk_rate, err);
+		return err;
 	}
 
-	mmc->actual_clock = clk_get_rate(host->cfg_div_clk);
+	mmc->actual_clock = clk_get_rate(shared->cfg_div_clk);
+
+	return 0;
+}
+
+static void meson_mx_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	struct meson_mx_mmc_host *host = mmc_priv(mmc);
+	struct meson_mx_mmc_shared *shared = host->shared;
+	unsigned short vdd = ios->vdd;
+	unsigned long irqflags;
 
 	switch (ios->power_mode) {
 	case MMC_POWER_OFF:
@@ -304,7 +359,32 @@ static void meson_mx_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
 				return;
 		}
 		break;
+	default:
+		break;
+	}
+
+	/*
+	 * Apply the shared settings only while the controller is idle, and
+	 * claim it for the duration so that a request of another slot cannot
+	 * interleave.
+	 */
+	for (;;) {
+		spin_lock_irqsave(&shared->lock, irqflags);
+		if (!shared->active) {
+			shared->active = host;
+			spin_unlock_irqrestore(&shared->lock, irqflags);
+			break;
+		}
+		spin_unlock_irqrestore(&shared->lock, irqflags);
+		wait_event(shared->idle_wq, !READ_ONCE(shared->active));
 	}
+
+	host->error = meson_mx_mmc_apply_ios(host);
+
+	spin_lock_irqsave(&shared->lock, irqflags);
+	shared->active = NULL;
+	spin_unlock_irqrestore(&shared->lock, irqflags);
+	wake_up(&shared->idle_wq);
 }
 
 static int meson_mx_mmc_map_dma(struct mmc_host *mmc, struct mmc_request *mrq)
